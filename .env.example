# Kopiere diese Datei nach .env und passe sie an. Die .env wird nicht ins Git-Repository übernommen.

# Port, unter dem die App erreichbar ist: http://localhost:8080
APP_PORT=8080

# --- Nur für die Live-Verbindung (docker compose --profile live up -d) ---
# Application ID aus dem Enable Banking Control Panel
EB_APP_ID=
# Langes Zufallspasswort; dasselbe trägst du in der App unter Profil → Live-Verbindung ein.
# Erzeugen z. B. in PowerShell:  [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
ACCESS_TOKEN=
# Adresse(n), unter denen du die App öffnest, kommagetrennt und ohne Pfad
ALLOWED_ORIGIN=http://localhost:8080
# Den privaten Schlüssel aus dem Control Panel speicherst du als secrets/enablebanking.pem
